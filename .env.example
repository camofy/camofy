# Generate a URL-safe database password, e.g. openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -base64 32 ; keep this key with database backups. Do not change on restart.
CAMOFY_ENCRYPTION_KEY=
CAMOFY_PUBLIC_URL=http://localhost:3000
# Optional comma-separated, trusted HTTPS origins during a domain migration.
CAMOFY_LEGACY_ORIGINS=
CAMOFY_REGISTRATION=true
CAMOFY_ALLOW_PRIVATE_EGRESS=false
CAMOFY_FETCH_WORKERS=8
# Captcha reading for panel-managed subscriptions such as WestData. Leave the key empty to
# disable those sources entirely; the image is sent only to this endpoint, never to the panel.
CAMOFY_VISION_API_KEY=
CAMOFY_VISION_API_URL=https://api.deepseek.com/chat/completions
CAMOFY_VISION_MODEL=deepseek-flash
# Optional read-only GitHub API token. Used only server-side for release metadata.
CAMOFY_GITHUB_TOKEN=
